<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>4K Ultra-HD Interactive 3D Solar System</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #020008;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: #f8fafc;
            user-select: none;
        }
        #canvas-container {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        /* Custom scrollbar */
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.5);
            border-radius: 4px;
        }
        /* Glassmorphism utility */
        .glass-panel {
            background: rgba(10, 15, 30, 0.82);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);
        }
    </style>
</head>
<body class="relative min-h-screen">

    <!-- Fullscreen 3D WebGL Canvas Container -->
    <div id="canvas-container"></div>

    <!-- UI Overlay Top Header & Planet Navigation Bar -->
    <div class="absolute top-0 left-0 right-0 z-10 p-4 flex flex-col md:flex-row items-center justify-between gap-4 bg-gradient-to-b from-slate-950/90 via-slate-950/40 to-transparent pointer-events-none">
        
        <!-- Logo & Title -->
        <div class="flex items-center gap-3 pointer-events-auto">
            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-amber-500 to-red-600 border border-amber-300/60 flex items-center justify-center text-amber-100 shadow-lg shadow-amber-500/30">
                <i class="fa-solid fa-sun text-xl animate-pulse"></i>
            </div>
            <div>
                <h1 class="text-xl font-extrabold tracking-wider text-white uppercase bg-clip-text text-transparent bg-gradient-to-r from-amber-200 via-indigo-200 to-cyan-300">
                    Cosmos 4K
                </h1>
                <p class="text-[10px] tracking-widest text-indigo-300/80 uppercase font-semibold">Hệ Mặt Trời 3D Tương Tác</p>
            </div>
        </div>

        <!-- Planet Selector Pills -->
        <div class="flex items-center gap-1.5 p-1.5 glass-panel rounded-full overflow-x-auto max-w-full custom-scrollbar pointer-events-auto">
            <button data-planet="Sun" class="planet-btn active-planet flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 hover:bg-amber-500/20 text-amber-300 border border-amber-500/50 shadow-md shadow-amber-500/20">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-sm shadow-amber-400"></span> Mặt Trời
            </button>
            <button data-planet="Mercury" class="planet-btn flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 hover:bg-slate-700/50 text-slate-300 border border-transparent">
                <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span> Sao Thủy
            </button>
            <button data-planet="Venus" class="planet-btn flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 hover:bg-amber-700/50 text-slate-300 border border-transparent">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-200"></span> Sao Kim
            </button>
            <button data-planet="Earth" class="planet-btn flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 hover:bg-blue-600/50 text-slate-300 border border-transparent">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span> Trái Đất
            </button>
            <button data-planet="Mars" class="planet-btn flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 hover:bg-red-600/50 text-slate-300 border border-transparent">
                <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span> Sao Hỏa
            </button>
            <button data-planet="Jupiter" class="planet-btn flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 hover:bg-orange-600/50 text-slate-300 border border-transparent">
                <span class="w-2.5 h-2.5 rounded-full bg-orange-300"></span> Sao Mộc
            </button>
            <button data-planet="Saturn" class="planet-btn flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 hover:bg-yellow-600/50 text-slate-300 border border-transparent">
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-200"></span> Sao Thổ
            </button>
            <button data-planet="Uranus" class="planet-btn flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 hover:bg-cyan-600/50 text-slate-300 border border-transparent">
                <span class="w-2.5 h-2.5 rounded-full bg-cyan-300"></span> Sao Thiên Vương
            </button>
            <button data-planet="Neptune" class="planet-btn flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 hover:bg-indigo-600/50 text-slate-300 border border-transparent">
                <span class="w-2.5 h-2.5 rounded-full bg-indigo-400"></span> Sao Hải Vương
            </button>
        </div>
    </div>

    <!-- Collapsible Info Panel Card (Right Floating) -->
    <div id="info-panel" class="absolute top-24 right-4 z-20 w-80 max-w-[calc(100vw-2rem)] glass-panel rounded-2xl p-4 text-slate-200 transition-all duration-300 ease-in-out">
        <!-- Panel Header -->
        <div class="flex items-center justify-between border-b border-slate-700/60 pb-2.5 mb-3">
            <div class="flex items-center gap-2.5">
                <div id="info-color-badge" class="w-3.5 h-3.5 rounded-full bg-amber-400 ring-4 ring-amber-400/20"></div>
                <div>
                    <span id="info-type" class="text-[10px] uppercase font-bold tracking-widest text-indigo-400 block">Star</span>
                    <h2 id="info-title" class="text-xl font-black text-white tracking-wide">Mặt Trời</h2>
                </div>
            </div>
            <!-- Minimize / Expand Toggle Button -->
            <button id="toggle-panel-btn" class="w-8 h-8 rounded-xl bg-slate-800/80 hover:bg-indigo-600/40 border border-slate-600/60 text-slate-300 flex items-center justify-center transition-all duration-200" title="Ẩn / Hiện thông tin">
                <i id="toggle-panel-icon" class="fa-solid fa-chevron-up text-xs"></i>
            </button>
        </div>

        <!-- Collapsible Content Section -->
        <div id="info-panel-content" class="transition-all duration-300 ease-in-out overflow-hidden max-h-[400px] opacity-100">
            <p id="info-description" class="text-xs leading-relaxed text-slate-300 mb-3 h-20 overflow-y-auto custom-scrollbar pr-1">
                Trái tim của Hệ Mặt Trời, chiếm 99.86% tổng khối lượng toàn hệ. Tạo ra năng lượng khổng lồ từ phản ứng nhiệt hạch ở nhiệt độ 15 triệu °C.
            </p>

            <!-- Stats Grid -->
            <div class="grid grid-cols-2 gap-2 text-xs mb-3">
                <div class="bg-slate-900/60 rounded-xl p-2 border border-slate-800/80">
                    <span class="text-[10px] text-slate-400 block mb-0.5">Đường kính</span>
                    <span id="stat-diameter" class="font-bold text-slate-100">1,392,700 km</span>
                </div>
                <div class="bg-slate-900/60 rounded-xl p-2 border border-slate-800/80">
                    <span class="text-[10px] text-slate-400 block mb-0.5">Chu kỳ quỹ đạo</span>
                    <span id="stat-period" class="font-bold text-slate-100">230 Triệu Năm</span>
                </div>
                <div class="bg-slate-900/60 rounded-xl p-2 border border-slate-800/80">
                    <span class="text-[10px] text-slate-400 block mb-0.5">Số vệ tinh</span>
                    <span id="stat-moons" class="font-bold text-slate-100">0</span>
                </div>
                <div class="bg-slate-900/60 rounded-xl p-2 border border-slate-800/80">
                    <span class="text-[10px] text-slate-400 block mb-0.5">Khoảng cách</span>
                    <span id="stat-distance" class="font-bold text-slate-100">0 AU</span>
                </div>
            </div>

            <button id="reset-cam-btn" class="w-full py-2 bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white rounded-xl text-xs font-bold tracking-wide transition-all shadow-md shadow-indigo-600/30 flex items-center justify-center gap-2">
                <i class="fa-solid fa-arrows-to-eye"></i> Định vị lại góc nhìn
            </button>
        </div>
    </div>

    <!-- Bottom Control Bar -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex items-center gap-3.5 glass-panel px-5 py-2.5 rounded-2xl max-w-full overflow-x-auto">
        <!-- Play / Pause -->
        <button id="play-pause-btn" class="w-9 h-9 rounded-xl bg-slate-800/80 hover:bg-slate-700 border border-slate-600/80 text-slate-200 flex items-center justify-center transition" title="Tạm dừng / Tiếp tục">
            <i class="fa-solid fa-pause text-sm" id="play-icon"></i>
        </button>

        <div class="h-6 w-px bg-slate-700/80"></div>

        <!-- Orbit Speed Slider -->
        <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-gauge-high text-xs text-indigo-400"></i>
            <span class="text-xs text-slate-300 font-medium whitespace-nowrap">Tốc độ:</span>
            <input id="speed-slider" type="range" min="0" max="3" step="0.1" value="1" class="w-24 accent-indigo-500 cursor-pointer">
            <span id="speed-val" class="text-xs font-mono text-indigo-300 w-8">1.0x</span>
        </div>

        <div class="h-6 w-px bg-slate-700/80"></div>

        <!-- Orbits Toggle -->
        <button id="toggle-orbits-btn" class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-indigo-600/20 border border-indigo-500/40 text-indigo-300 text-xs font-medium hover:bg-indigo-600/30 transition">
            <i class="fa-solid fa-circle-notch text-xs"></i> Quỹ đạo: BẬT
        </button>

        <div class="h-6 w-px bg-slate-700/80"></div>

        <!-- Audio Space Ambient Synth Toggle -->
        <button id="toggle-audio-btn" class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-800/80 border border-slate-600/80 text-slate-300 text-xs font-medium hover:bg-slate-700 transition">
            <i class="fa-solid fa-volume-xmark text-xs" id="audio-icon"></i> Âm thanh vũ trụ
        </button>
    </div>

    <!-- Three.js & Controls via CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

    <script>
        window.addEventListener('load', () => {
            // ----------------------------------------------------
            // 1. DATA DEFINITIONS FOR PLANETS & SUN
            // ----------------------------------------------------
            const celestialData = {
