                    moons: "1 (Mặt Trăng)",
                    distance: "1.00 AU",
                    color: "#3b82f6",
                    size: 1.4,
                    dist: 26,
                    speed: 0.02,
                    rotSpeed: 0.015
                },
                Mars: {
                    nameVi: "Sao Hỏa",
                    type: "Hành tinh đất đá",
                    description: "Hành tinh Đỏ giàu oxit sắt, sở hữu ngọn núi cao nhất hệ mặt trời Olympus Mons và thung lũng khổng lồ Valles Marineris.",
                    diameter: "6,779 km",
                    period: "687 Ngày",
                    moons: "2 (Phobos, Deimos)",
                    distance: "1.52 AU",
                    color: "#ef4444",
                    size: 1.0,
                    dist: 33,
