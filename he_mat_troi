                    rotSpeed: 0.012
                },
                Jupiter: {
                    nameVi: "Sao Mộc",
                    type: "Hành tinh khí khổng lồ",
                    description: "Gã khổng lồ khí lớn nhất hệ mặt trời với các dải mây chuyển động siêu tốc và siêu bão Vết Đỏ Cứu mang kích thước lớn hơn Trái Đất.",
                    diameter: "139,822 km",
                    period: "11.8 Năm",
                    moons: "95",
                    distance: "5.20 AU",
                    color: "#fdba74",
                    size: 3.2,
                    dist: 45,
                    speed: 0.01,
                    rotSpeed: 0.025
                },
                Saturn: {
                    nameVi: "Sao Thổ",
                    type: "Hành tinh khí khổng lồ",
                    description: "Nổi tiếng với hệ thống vành đai băng rực rỡ và Cassini Division sắc nét, cùng hàng trăm vệ tinh tự nhiên.",
                    diameter: "116,460 km",
                    period: "29.5 Năm",
                    moons: "146",
                    distance: "9.58 AU",
                    color: "#fef08a",
                    size: 2.7,
                    dist: 58,
                    speed: 0.007,
                    rotSpeed: 0.022
                },
                Uranus: {
                    nameVi: "Sao Thiên Vương",
                    type: "Hành tinh băng khổng lồ",
                    description: "Hành tinh màu xanh cyan sở hữu trục nghiêng độc đáo 98 độ khiến nó như 'lăn' trên quỹ đạo quanh Mặt Trời.",
                    diameter: "50,724 km",
                    period: "84 Năm",
                    moons: "28",
                    distance: "19.2 AU",
                    color: "#67e8f9",
                    size: 1.9,
                    dist: 70,
                    speed: 0.005,
                    rotSpeed: -0.016
                },
                Neptune: {
                    nameVi: "Sao Hải Vương",
                    type: "Hành tinh băng khổng lồ",
                    description: "Hành tinh xa nhất trong hệ, nổi bật với màu xanh lam đậm và những cơn gió siết siêu thanh đạt tốc độ 2,100 km/h.",
                    diameter: "49,244 km",
                    period: "165 Năm",
                    moons: "16",
                    distance: "30.1 AU",
                    color: "#818cf8",
                    size: 1.8,
                    dist: 80,
                    speed: 0.0035,
                    rotSpeed: 0.018
                }
            };

            // ----------------------------------------------------
            // 2. SCENE, CAMERA, RENDERER & CONTROLS SETUP
            // ----------------------------------------------------
            const container = document.getElementById('canvas-container');
            const clock = new THREE.Clock();

            const scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x020008, 0.002);

            const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 2000);
            camera.position.set(0, 45, 95);

            const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.3;
            container.appendChild(renderer.domElement);

            const controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.04;
            controls.maxDistance = 350;
            controls.minDistance = 2.5;

            // ----------------------------------------------------
            // 3. LIGHTING SYSTEM
            // ----------------------------------------------------
            const ambientLight = new THREE.AmbientLight(0x38bdf8, 0.2);
            scene.add(ambientLight);

            // Sun Central Point Light
            const sunLight = new THREE.PointLight(0xfff7ed, 4.0, 400, 0.3);
            scene.add(sunLight);

            // Subtle directional fill for deep-space shadow balance
            const fillLight = new THREE.DirectionalLight(0x818cf8, 0.15);
            fillLight.position.set(0, 80, 0);
            scene.add(fillLight);

            // ----------------------------------------------------
            // 4. ULTRA-HIGH RES (4096x2048) PROCEDURAL TEXTURE GENERATORS
            // ----------------------------------------------------
            function create4KCanvas() {
                const canvas = document.createElement('canvas');
                canvas.width = 4096;
                canvas.height = 2048;
                return canvas;
            }

            // Sun 4K Texture
            function createSun4KTexture() {
                const canvas = create4KCanvas();
                const ctx = canvas.getContext('2d');
                ctx.fillStyle = '#f59e0b';
                ctx.fillRect(0, 0, 4096, 2048);

                for (let i = 0; i < 4000; i++) {
                    const x = Math.random() * 4096;
                    const y = Math.random() * 2048;
                    const r = Math.random() * 60 + 15;
                    const grad = ctx.createRadialGradient(x, y, 0, x, y, r);
                    grad.addColorStop(0, '#fef08a');
                    grad.addColorStop(0.5, '#f97316');
                    grad.addColorStop(1, 'transparent');
                    ctx.fillStyle = grad;
                    ctx.beginPath();
                    ctx.arc(x, y, r, 0, Math.PI * 2);
                    ctx.fill();
                }
                return new THREE.CanvasTexture(canvas);
            }

            // Earth 4K Textures
            function createEarthTextures() {
                const dayCanvas = create4KCanvas();
                const dayCtx = dayCanvas.getContext('2d');
                dayCtx.fillStyle = '#0f3854';
                dayCtx.fillRect(0, 0, 4096, 2048);

                dayCtx.fillStyle = '#15803d';
                for (let i = 0; i < 350; i++) {
                    const x = Math.random() * 4096;
                    const y = Math.random() * 2048;
                    const r = Math.random() * 180 + 30;
                    dayCtx.beginPath();
                    dayCtx.arc(x, y, r, 0, Math.PI * 2);
                    dayCtx.fill();
                }

                const cloudCanvas = create4KCanvas();
                const cloudCtx = cloudCanvas.getContext('2d');
                cloudCtx.fillStyle = 'rgba(255, 255, 255, 0)';
                cloudCtx.fillRect(0, 0, 4096, 2048);
                cloudCtx.fillStyle = '#ffffff';
                for (let i = 0; i < 600; i++) {
                    cloudCtx.globalAlpha = Math.random() * 0.35 + 0.05;
                    cloudCtx.fillRect(Math.random() * 4096, Math.random() * 2048, Math.random() * 300 + 50, Math.random() * 20 + 4);
                }

                return {
                    day: new THREE.CanvasTexture(dayCanvas),
                    clouds: new THREE.CanvasTexture(cloudCanvas)
                };
            }

            // Generic Banded Texture Generator
            function createBanded4KTexture(colorStops, stormSpots = false) {
                const canvas = create4KCanvas();
                const ctx = canvas.getContext('2d');

                const grad = ctx.createLinearGradient(0, 0, 0, 2048);
                colorStops.forEach(cs => grad.addColorStop(cs.stop, cs.color));
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, 4096, 2048);

                for (let y = 0; y < 2048; y += 4) {
                    const opacity = Math.sin(y * 0.05) * 0.15 + 0.05;
                    ctx.fillStyle = `rgba(255, 255, 255, ${opacity})`;
                    ctx.fillRect(0, y, 4096, 2);
                }

                if (stormSpots) {
                    ctx.fillStyle = 'rgba(185, 28, 28, 0.85)';
                    ctx.beginPath();
                    ctx.ellipse(2600, 1300, 220, 130, 0, 0, Math.PI * 2);
                    ctx.fill();
                }

                return new THREE.CanvasTexture(canvas);
            }

            // Saturn 4K Rings
            function createSaturn4KRingsTexture() {
                const canvas = document.createElement('canvas');
                canvas.width = 4096;
                canvas.height = 1;
                const ctx = canvas.getContext('2d');

                const grad = ctx.createLinearGradient(0, 0, 4096, 0);
                grad.addColorStop(0.00, 'rgba(0,0,0,0)');
                grad.addColorStop(0.12, 'rgba(6, 182, 212, 0.6)');
                grad.addColorStop(0.28, 'rgba(245, 158, 11, 0.95)');
                grad.addColorStop(0.55, 'rgba(0, 0, 0, 0.02)');
                grad.addColorStop(0.58, 'rgba(168, 85, 247, 0.85)');
                grad.addColorStop(0.88, 'rgba(59, 130, 246, 0.5)');
                grad.addColorStop(1.00, 'rgba(0,0,0,0)');

                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, 4096, 1);

                for (let i = 0; i < 400; i++) {
                    const pos = Math.floor(Math.random() * 4096);
                    ctx.fillStyle = `rgba(0,0,0,${Math.random() * 0.4})`;
                    ctx.fillRect(pos, 0, Math.random() * 3 + 1, 1);
                }

                return new THREE.CanvasTexture(canvas);
            }

            // Atmosphere Material
            function createAtmosphereMaterial(glowColor) {
                return new THREE.ShaderMaterial({
                    vertexShader: `
                        varying vec3 vNormal;
                        void main() {
                            vNormal = normalize(normalMatrix * normal);
                            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
                        }
                    `,
                    fragmentShader: `
                        varying vec3 vNormal;
                        uniform vec3 color;
                        void main() {
                            float intensity = pow(0.65 - dot(vNormal, vec3(0, 0, 1.0)), 2.8);
                            gl_FragColor = vec4(color, 1.0) * intensity * 1.6;
                        }
                    `,
                    uniforms: {
                        color: { value: new THREE.Color(glowColor) }
                    },
                    blending: THREE.AdditiveBlending,
                    side: THREE.BackSide,
                    transparent: true
                });
            }

            // ----------------------------------------------------
            // 5. MESH CREATION & ORBITS
            // ----------------------------------------------------
            const planetMeshes = {};
            const orbitLines = [];
            const celestialGroup = new THREE.Group();
            scene.add(celestialGroup);

            // Sun Mesh
            const sunGeo = new THREE.SphereGeometry(celestialData.Sun.size, 128, 128);
            const sunTex = createSun4KTexture();
            const sunMat = new THREE.MeshBasicMaterial({ map: sunTex });
            const sunMesh = new THREE.Mesh(sunGeo, sunMat);
            celestialGroup.add(sunMesh);
            planetMeshes['Sun'] = sunMesh;

            const coronaMesh = new THREE.Mesh(
                new THREE.SphereGeometry(celestialData.Sun.size * 1.25, 64, 64),
                createAtmosphereMaterial(0xf59e0b)
            );
            sunMesh.add(coronaMesh);

            // Planets
            const earthTextures = createEarthTextures();

            Object.keys(celestialData).forEach(name => {
                if (name === 'Sun') return;

                const data = celestialData[name];
                const pivot = new THREE.Group();
                celestialGroup.add(pivot);

                const geo = new THREE.SphereGeometry(data.size, 128, 128);
                let mat;

                if (name === 'Mercury') {
                    mat = new THREE.MeshStandardMaterial({ map: createBanded4KTexture([{stop:0, color:'#52525b'}, {stop:1, color:'#a1a1aa'}]), roughness: 0.9 });
                } else if (name === 'Venus') {
                    mat = new THREE.MeshStandardMaterial({ map: createBanded4KTexture([{stop:0, color:'#fef08a'}, {stop:0.5, color:'#f59e0b'}, {stop:1, color:'#d97706'}]), roughness: 0.4 });
                } else if (name === 'Earth') {
                    mat = new THREE.MeshStandardMaterial({ map: earthTextures.day, roughness: 0.45, metalness: 0.1 });
                } else if (name === 'Mars') {
                    mat = new THREE.MeshStandardMaterial({ map: createBanded4KTexture([{stop:0, color:'#ef4444'}, {stop:0.5, color:'#b91c1c'}, {stop:1, color:'#7f1d1d'}]), roughness: 0.8 });
                } else if (name === 'Jupiter') {
                    mat = new THREE.MeshStandardMaterial({ map: createBanded4KTexture([{stop:0, color:'#fed7aa'}, {stop:0.3, color:'#c2410c'}, {stop:0.6, color:'#fde047'}, {stop:1, color:'#7c2d12'}], true), roughness: 0.35 });
                } else if (name === 'Saturn') {
                    mat = new THREE.MeshStandardMaterial({ map: createBanded4KTexture([{stop:0, color:'#fef08a'}, {stop:0.5, color:'#d97706'}, {stop:1, color:'#a16207'}]), roughness: 0.4 });
                } else if (name === 'Uranus') {
                    mat = new THREE.MeshStandardMaterial({ map: createBanded4KTexture([{stop:0, color:'#67e8f9'}, {stop:1, color:'#0284c7'}]), roughness: 0.25 });
                } else if (name === 'Neptune') {
                    mat = new THREE.MeshStandardMaterial({ map: createBanded4KTexture([{stop:0, color:'#818cf8'}, {stop:1, color:'#1e1b4b'}]), roughness: 0.25 });
                }

                const mesh = new THREE.Mesh(geo, mat);
                mesh.position.x = data.dist;
                pivot.add(mesh);

                planetMeshes[name] = mesh;
                mesh.userData = { pivot, angle: Math.random() * Math.PI * 2, speed: data.speed, rotSpeed: data.rotSpeed };

                const atmosphereGlow = new THREE.Mesh(
                    new THREE.SphereGeometry(data.size * 1.08, 64, 64),
                    createAtmosphereMaterial(data.color)
                );
                mesh.add(atmosphereGlow);

                if (name === 'Earth') {
                    const cloudMesh = new THREE.Mesh(
                        new THREE.SphereGeometry(data.size * 1.02, 64, 64),
                        new THREE.MeshStandardMaterial({ map: earthTextures.clouds, transparent: true, opacity: 0.8 })
                    );
                    mesh.add(cloudMesh);
                    mesh.userData.cloudMesh = cloudMesh;

                    const moonMesh = new THREE.Mesh(
                        new THREE.SphereGeometry(0.35, 32, 32),
                        new THREE.MeshStandardMaterial({ color: 0xcbd5e1, roughness: 0.9 })
                    );
                    moonMesh.position.x = 2.6;
                    const moonPivot = new THREE.Group();
                    mesh.add(moonPivot);
                    moonPivot.add(moonMesh);
                    mesh.userData.moonPivot = moonPivot;
                }

                if (name === 'Saturn') {
                    const ringGeo = new THREE.RingGeometry(data.size * 1.35, data.size * 2.6, 128);
                    const pos = ringGeo.attributes.position;
                    const uv = ringGeo.attributes.uv;
                    for (let i = 0; i < pos.count; i++) {
                        const x = pos.getX(i);
                        const y = pos.getY(i);
                        const distance = Math.sqrt(x * x + y * y);
                        const normalized = (distance - data.size * 1.35) / (data.size * 1.25);
                        uv.setXY(i, normalized, 0.5);
                    }

                    const ringMesh = new THREE.Mesh(ringGeo, new THREE.MeshStandardMaterial({
                        map: createSaturn4KRingsTexture(),
                        side: THREE.DoubleSide,
                        transparent: true,
                        opacity: 0.92,
                        roughness: 0.3
                    }));
                    ringMesh.rotation.x = Math.PI / 2.2;
                    mesh.add(ringMesh);
                }

                // Orbit Line
                const orbitGeo = new THREE.BufferGeometry();
                const points = [];
                for (let i = 0; i <= 128; i++) {
                    const theta = (i / 128) * Math.PI * 2;
                    points.push(new THREE.Vector3(Math.cos(theta) * data.dist, 0, Math.sin(theta) * data.dist));
                }
                orbitGeo.setFromPoints(points);

                const orbitLine = new THREE.Line(orbitGeo, new THREE.LineBasicMaterial({ color: 0x475569, transparent: true, opacity: 0.3 }));
                celestialGroup.add(orbitLine);
                orbitLines.push(orbitLine);
            });

            // Starfield
            const starGeo = new THREE.BufferGeometry();
            const starCount = 50000;
            const starPos = new Float32Array(starCount * 3);
            const starCols = new Float32Array(starCount * 3);

            const spectralColors = [
                new THREE.Color(0x9bb0ff),
                new THREE.Color(0xaabfff),
                new THREE.Color(0xcad7ff),
                new THREE.Color(0xf8f7ff),
                new THREE.Color(0xfff4ea),
                new THREE.Color(0xffd2a1)
            ];

            for (let i = 0; i < starCount; i++) {
                starPos[i * 3] = (Math.random() - 0.5) * 1000;
                starPos[i * 3 + 1] = (Math.random() - 0.5) * 1000;
                starPos[i * 3 + 2] = (Math.random() - 0.5) * 1000;

                const c = spectralColors[Math.floor(Math.random() * spectralColors.length)];
                starCols[i * 3] = c.r;
                starCols[i * 3 + 1] = c.g;
                starCols[i * 3 + 2] = c.b;
            }

            starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
            starGeo.setAttribute('color', new THREE.BufferAttribute(starCols, 3));
            const starField = new THREE.Points(starGeo, new THREE.PointsMaterial({ size: 0.8, vertexColors: true, transparent: true, opacity: 0.85 }));
            scene.add(starField);

            // Asteroid Belt
            const asteroidGeo = new THREE.BufferGeometry();
            const asteroidCount = 3500;
            const asteroidPos = new Float32Array(asteroidCount * 3);

            for (let i = 0; i < asteroidCount; i++) {
                const rad = 37 + Math.random() * 6;
                const angle = Math.random() * Math.PI * 2;
                asteroidPos[i * 3] = Math.cos(angle) * rad;
                asteroidPos[i * 3 + 1] = (Math.random() - 0.5) * 1.8;
                asteroidPos[i * 3 + 2] = Math.sin(angle) * rad;
            }

            asteroidGeo.setAttribute('position', new THREE.BufferAttribute(asteroidPos, 3));
            const asteroidMesh = new THREE.Points(asteroidGeo, new THREE.PointsMaterial({ size: 0.25, color: 0x94a3b8, transparent: true, opacity: 0.7 }));
            celestialGroup.add(asteroidMesh);

            // ----------------------------------------------------
            // 6. UI TOGGLE & INTERACTION CONTROLS
            // ----------------------------------------------------
            let currentFocusedPlanet = 'Sun';
            let isPaused = false;
            let timeSpeed = 1.0;
            let isOrbitVisible = true;
            let isPanelExpanded = true;

            const infoTitle = document.getElementById('info-title');
            const infoType = document.getElementById('info-type');
            const infoDesc = document.getElementById('info-description');
            const infoBadge = document.getElementById('info-color-badge');
            const statDiameter = document.getElementById('stat-diameter');
            const statPeriod = document.getElementById('stat-period');
            const statMoons = document.getElementById('stat-moons');
            const statDistance = document.getElementById('stat-distance');

            const infoPanelContent = document.getElementById('info-panel-content');
            const togglePanelBtn = document.getElementById('toggle-panel-btn');
            const togglePanelIcon = document.getElementById('toggle-panel-icon');

            // Robust Panel Collapse/Expand
            togglePanelBtn.addEventListener('click', () => {
                isPanelExpanded = !isPanelExpanded;
                if (isPanelExpanded) {
                    infoPanelContent.style.maxHeight = '400px';
                    infoPanelContent.style.opacity = '1';
                    infoPanelContent.style.marginTop = '0px';
                    togglePanelIcon.className = 'fa-solid fa-chevron-up text-xs';
                } else {
                    infoPanelContent.style.maxHeight = '0px';
                    infoPanelContent.style.opacity = '0';
                    infoPanelContent.style.marginTop = '-8px';
                    togglePanelIcon.className = 'fa-solid fa-chevron-down text-xs';
                }
            });

            function updateInfoPanel(name) {
                const data = celestialData[name];
                infoTitle.innerText = data.nameVi;
                infoType.innerText = data.type;
                infoDesc.innerText = data.description;
                infoBadge.style.backgroundColor = data.color;
                infoBadge.style.boxShadow = `0 0 16px ${data.color}`;
                statDiameter.innerText = data.diameter;
                statPeriod.innerText = data.period;
                statMoons.innerText = data.moons;
                statDistance.innerText = data.distance;
            }

            function focusPlanet(name) {
                currentFocusedPlanet = name;
                updateInfoPanel(name);

                document.querySelectorAll('.planet-btn').forEach(btn => {
                    if (btn.dataset.planet === name) {
                        btn.classList.add('active-planet', 'border-amber-500/50', 'bg-slate-800/80', 'shadow-amber-500/20');
                        btn.classList.remove('border-transparent');
                    } else {
                        btn.classList.remove('active-planet', 'border-amber-500/50', 'bg-slate-800/80', 'shadow-amber-500/20');
                        btn.classList.add('border-transparent');
                    }
                });
            }

            document.querySelectorAll('.planet-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    focusPlanet(e.currentTarget.dataset.planet);
                });
            });

            document.getElementById('reset-cam-btn').addEventListener('click', () => {
                focusPlanet('Sun');
            });

            // Play / Pause
            const playPauseBtn = document.getElementById('play-pause-btn');
            const playIcon = document.getElementById('play-icon');
            playPauseBtn.addEventListener('click', () => {
                isPaused = !isPaused;
                playIcon.className = isPaused ? 'fa-solid fa-play text-sm' : 'fa-solid fa-pause text-sm';
            });

            // Orbit Speed
            const speedSlider = document.getElementById('speed-slider');
            const speedVal = document.getElementById('speed-val');
            speedSlider.addEventListener('input', (e) => {
                timeSpeed = parseFloat(e.target.value);
                speedVal.innerText = `${timeSpeed.toFixed(1)}x`;
            });

            // Toggle Orbits
            const toggleOrbitsBtn = document.getElementById('toggle-orbits-btn');
            toggleOrbitsBtn.addEventListener('click', () => {
                isOrbitVisible = !isOrbitVisible;
                orbitLines.forEach(line => line.visible = isOrbitVisible);
                toggleOrbitsBtn.innerHTML = isOrbitVisible ? 
                    '<i class="fa-solid fa-circle-notch text-xs"></i> Quỹ đạo: BẬT' : 
                    '<i class="fa-solid fa-circle-notch text-xs opacity-50"></i> Quỹ đạo: TẮT';
            });

            // Audio Space Ambient Synth
            let audioCtx = null;
            let isAudioPlaying = false;
            const toggleAudioBtn = document.getElementById('toggle-audio-btn');
            const audioIcon = document.getElementById('audio-icon');

            toggleAudioBtn.addEventListener('click', () => {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(55, audioCtx.currentTime);
                    gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start();
                }

                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                    isAudioPlaying = true;
                } else if (audioCtx.state === 'running') {
                    audioCtx.suspend();
                    isAudioPlaying = false;
                }

                audioIcon.className = isAudioPlaying ? 'fa-solid fa-volume-high text-xs text-indigo-400' : 'fa-solid fa-volume-xmark text-xs';
            });

            // Direct 3D Raycasting Clicks
            const raycaster = new THREE.Raycaster();
            const mouse = new THREE.Vector2();

            window.addEventListener('click', (e) => {
                if (e.target.closest('#info-panel') || e.target.closest('button') || e.target.closest('input')) return;

                mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
                mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;

                raycaster.setFromCamera(mouse, camera);
                const intersects = raycaster.intersectObjects(Object.values(planetMeshes));

                if (intersects.length > 0) {
                    const hitMesh = intersects[0].object;
                    for (const [name, mesh] of Object.entries(planetMeshes)) {
                        if (mesh === hitMesh) {
                            focusPlanet(name);
                            break;
                        }
                    }
                }
            });

            // ----------------------------------------------------
            // 7. ANIMATION LOOP & CAMERA TRACKING
            // ----------------------------------------------------
            const targetLookAt = new THREE.Vector3();

            function animate() {
                requestAnimationFrame(animate);

                Object.keys(planetMeshes).forEach(name => {
                    const mesh = planetMeshes[name];

                    if (name === 'Sun') {
                        mesh.rotation.y += celestialData.Sun.rotSpeed;
                    } else if (!isPaused) {
                        mesh.userData.angle += mesh.userData.speed * timeSpeed * 0.4;
                        mesh.position.x = Math.cos(mesh.userData.angle) * celestialData[name].dist;
                        mesh.position.z = Math.sin(mesh.userData.angle) * celestialData[name].dist;

                        mesh.rotation.y += mesh.userData.rotSpeed * timeSpeed;

                        if (name === 'Earth') {
                            if (mesh.userData.cloudMesh) mesh.userData.cloudMesh.rotation.y += 0.002 * timeSpeed;
                            if (mesh.userData.moonPivot) mesh.userData.moonPivot.rotation.y += 0.02 * timeSpeed;
                        }
                    }
                });

                // Camera Tracking Smooth Lerp
                const targetMesh = planetMeshes[currentFocusedPlanet];
                if (targetMesh) {
                    const worldPos = new THREE.Vector3();
                    targetMesh.getWorldPosition(worldPos);

                    targetLookAt.lerp(worldPos, 0.05);
                    controls.target.copy(targetLookAt);
                }

                asteroidMesh.rotation.y += 0.0003;
                starField.rotation.y += 0.00005;

                controls.update();
                renderer.render(scene, camera);
            }

            animate();

            // Responsive Window Resize
            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        });
    </script>
</body>
</html>
